# Flora Shanghai Aesthetics V1 — secret-free environment example
# Copy to .env only in a private deployment environment. Never commit real values.

# Server
PORT=3000
NODE_ENV=development

# Optional database persistence. Leave blank for local mode.
DATABASE_URL=

# Optional production site metadata
PUBLIC_SITE_URL=https://example.com

# Optional future CRM adapter; current code does not call it automatically.
CRM_ADAPTER_URL=
CRM_ADAPTER_TOKEN=

# Secure photo uploads remain disabled unless the full workflow is implemented and reviewed.
CONSULTATION_STORAGE_MODE=disabled

# Optional analytics IDs; no events leave the browser if these are blank.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# Public contact information (displayed in footer)
VITE_CONTACT_EMAIL=
# International WhatsApp (Cambodia). Digits-only also OK; footer strips non-digits for wa.me.
VITE_CONTACT_WHATSAPP=+855969510544
# Instagram handle without @
VITE_CONTACT_INSTAGRAM=goat.2014238
